# Testable runtime env contract for data-dyna.
# These are placeholder local/test values, not production credentials.
DATA_DYNA_RUNTIME_ENV=local
DATA_DYNA_HTTP_HOST=0.0.0.0
DATA_DYNA_HTTP_PORT=3000
DATA_DYNA_DATABASE_URL=postgresql://data_dyna:data_dyna_local_password@localhost:55432/data_dyna_test

# Local/CI-only PostgreSQL test substrate for data-dyna.
DATA_DYNA_TEST_DB_NAME=data_dyna_test
DATA_DYNA_TEST_DB_USER=data_dyna
DATA_DYNA_TEST_DB_PASSWORD=data_dyna_local_password
DATA_DYNA_TEST_DB_HOST=localhost
DATA_DYNA_TEST_DB_PORT=55432
DATA_DYNA_TEST_DATABASE_URL=postgresql://data_dyna:data_dyna_local_password@localhost:55432/data_dyna_test
